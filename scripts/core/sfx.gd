extends Node
## Plays the procedurally synthesised sound effects and music. The sounds are
## generated by the Synth child node (sfx_synth.gd) on a worker thread, so the
## game can draw its loading screen meanwhile. Sounds requested before
## synthesis finishes are skipped; requested music starts when it's ready.
##
## PATCH SAFETY: installed copies apply content patches by swapping this
## autoload's script in place, and the live object keeps the member-variable
## slots of the version that was installed. Never add, remove, retype or
## reorder the member variables below (scripts/tools/check_autoload_layout.py
## enforces this). Functions and constants may change; new state belongs in a
## child node. Adding members in 0.1.2 crashed 0.1.0/0.1.1 copies.

const POOL_3D := 24
const POOL_2D := 10

var streams := {}
var _pool3d: Array[AudioStreamPlayer3D] = []
var _pool2d: Array[AudioStreamPlayer] = []
var _i3 := 0
var _i2 := 0
var _music: AudioStreamPlayer
var _rng := RandomNumberGenerator.new()


func setup() -> void:
	_rng.seed = 1337
	for i in POOL_3D:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.unit_size = 6.0
		p.max_distance = 60.0
		p.attenuation_filter_cutoff_hz = 6000.0
		add_child(p)
		_pool3d.append(p)
	for i in POOL_2D:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool2d.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	var synth: Node = load("res://scripts/core/sfx_synth.gd").new()
	synth.name = "Synth"
	add_child(synth)
	synth.start()


## True once every sound has been synthesised.
func is_ready() -> bool:
	var synth := get_node_or_null("Synth")
	return synth == null or synth.done


## 0..1, for loading screens.
func progress() -> float:
	var synth := get_node_or_null("Synth")
	return 1.0 if synth == null else synth.progress()


func play(sound: String, vol_db := 0.0, pitch_var := 0.04) -> void:
	if not streams.has(sound):
		return
	var p := _pool2d[_i2]
	_i2 = (_i2 + 1) % POOL_2D
	p.stream = streams[sound]
	p.volume_db = vol_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()


func play_at(sound: String, pos: Vector3, vol_db := 0.0, pitch_var := 0.06) -> void:
	if not streams.has(sound):
		return
	var p := _pool3d[_i3]
	_i3 = (_i3 + 1) % POOL_3D
	p.stream = streams[sound]
	p.global_position = pos
	p.volume_db = vol_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()


func music(track: String) -> void:
	var synth := get_node_or_null("Synth")
	if synth and not synth.done:
		synth.want_music = track   # played once synthesis finishes
		return
	if track == "":
		_music.stop()
		return
	if _music.stream == streams.get(track) and _music.playing:
		return
	_music.stream = streams.get(track)
	_music.volume_db = -4.0
	_music.play()
