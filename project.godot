; Engine configuration file.
config_version=5

[application]

config/name="Cinderhold"
config/description="Co-op voxel wave survival. Hold the line until dawn."
config/version="0.1.2"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.025, 0.03, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

Settings="*res://scripts/core/settings.gd"
Net="*res://scripts/core/net.gd"
Sfx="*res://scripts/core/sfx.gd"
Updater="*res://scripts/core/updater.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
